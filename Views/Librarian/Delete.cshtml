@model midterm_project.Models.Librarian

<h2 class="text-danger">Delete Librarian</h2>

<div class="alert alert-warning">Are you sure you want to delete this librarian?</div>

<div class="card p-3 mb-3">
    <p><strong>Name:</strong> @Model.FullName</p>
    <p><strong>Email:</strong> @Model.Email</p>
    <p><strong>Branch:</strong> @Model.LibraryBranch?.Name</p>
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="LibrarianId" />
    <button type="submit" class="btn btn-danger me-2">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
