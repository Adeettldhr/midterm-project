@model IEnumerable<midterm_project.Models.Author>

<h2>Authors</h2>

<p>
    <a asp-action="Create" class="btn btn-success">Add New Author</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Birth Date</th>
            <th>Bio</th>
            <th>Books</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var author in Model)
        {
            <tr>
                <td>@author.Name</td>
                <td>@author.BirthDate?.ToString("yyyy-MM-dd")</td>
                <td>@author.Bio</td>
<td>@(author.Books?.Count() ?? 0)</td>
                <td>
                    <a asp-action="Details" asp-route-id="@author.AuthorId" class="btn btn-info btn-sm">Details</a>
                    <a asp-action="Edit" asp-route-id="@author.AuthorId" class="btn btn-primary btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@author.AuthorId" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
