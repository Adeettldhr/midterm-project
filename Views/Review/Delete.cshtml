@model midterm_project.Models.Review

<h2 class="text-danger">Delete Review</h2>
<div class="alert alert-warning">Are you sure you want to delete this review?</div>

<div class="card p-3 mb-3">
    <p><strong>Book:</strong> @Model.Book?.Title</p>
    <p><strong>Customer:</strong> @Model.Customer?.FullName</p>
    <p><strong>Rating:</strong> @Model.Rating</p>
    <p><strong>Comment:</strong> @Model.Comment</p>
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="ReviewId" />
    <button type="submit" class="btn btn-danger me-2">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
