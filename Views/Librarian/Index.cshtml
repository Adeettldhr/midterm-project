@model IEnumerable<midterm_project.Models.Librarian>

<h2>Librarians</h2>
<a asp-action="Create" class="btn btn-primary mb-3">Add Librarian</a>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Hired Date</th>
            <th>Branch</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var librarian in Model)
    {
        <tr>
            <td>@librarian.FullName</td>
            <td>@librarian.Email</td>
            <td>@librarian.Phone</td>
            <td>@librarian.HiredDate.ToString("yyyy-MM-dd")</td>
            <td>@librarian.LibraryBranch?.Name</td>
            <td>
                <a asp-action="Edit" asp-route-id="@librarian.LibrarianId" class="btn btn-warning btn-sm">Edit</a>
                <a asp-action="Details" asp-route-id="@librarian.LibrarianId" class="btn btn-info btn-sm">Details</a>
                <a asp-action="Delete" asp-route-id="@librarian.LibrarianId" class="btn btn-danger btn-sm">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
