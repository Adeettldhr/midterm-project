@model midterm_project.Models.HomeViewModel

@{
    ViewData["Title"] = "Library Overview";
}

<div class="container py-5">
    <h1 class="text-center mb-5 fw-bold text-primary">📚 Library Management Dashboard</h1>

    <div class="row g-4">

        <!-- Books -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h4 class="card-title text-primary"><i class="bi bi-book-half me-2"></i>Books</h4>
                    @if (Model.Books != null && Model.Books.Any())
                    {
                        <table class="table table-sm mt-3">
                            <thead class="table-light">
                                <tr><th>Title</th><th>Author</th></tr>
                            </thead>
                            <tbody>
                            @foreach (var book in Model.Books.Take(5))
                            {
                                <tr>
                                    <td>@book.Title</td>
                                    <td>@book.Author?.Name</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                        <a asp-controller="Book" asp-action="Index" class="btn btn-outline-primary btn-sm w-100 mt-2">View All</a>
                    }
                    else
                    {
                        <p class="text-muted mt-3">No books available.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Authors -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h4 class="card-title text-success"><i class="bi bi-person-lines-fill me-2"></i>Authors</h4>
                    @if (Model.Authors != null && Model.Authors.Any())
                    {
                        <ul class="list-group list-group-flush mt-3">
                            @foreach (var author in Model.Authors.Take(5))
                            {
                                <li class="list-group-item px-0">
                                    <strong>@author.Name</strong>
                                    <small class="text-muted d-block">(@author.Bio)</small>
                                </li>
                            }
                        </ul>
                        <a asp-controller="Author" asp-action="Index" class="btn btn-outline-success btn-sm w-100 mt-2">View All</a>
                    }
                    else
                    {
                        <p class="text-muted mt-3">No authors found.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Customers -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h4 class="card-title text-warning"><i class="bi bi-people-fill me-2"></i>Customers</h4>
                    @if (Model.Customers != null && Model.Customers.Any())
                    {
                        <ul class="list-group list-group-flush mt-3">
                            @foreach (var customer in Model.Customers.Take(5))
                            {
                                <li class="list-group-item px-0">
                                    <strong>@customer.FullName</strong><br />
                                    <small class="text-muted">@customer.Email</small>
                                </li>
                            }
                        </ul>
                        <a asp-controller="Customer" asp-action="Index" class="btn btn-outline-warning btn-sm w-100 mt-2">View All</a>
                    }
                    else
                    {
                        <p class="text-muted mt-3">No customers registered yet.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Library Branches -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h4 class="card-title text-danger"><i class="bi bi-building me-2"></i>Branches</h4>
                    @if (Model.LibraryBranches != null && Model.LibraryBranches.Any())
                    {
                        <ul class="list-group list-group-flush mt-3">
                            @foreach (var branch in Model.LibraryBranches.Take(5))
                            {
                                <li class="list-group-item px-0">
                                    <strong>@branch.Name</strong><br />
                                    <small class="text-muted">@branch.Address</small>
                                </li>
                            }
                        </ul>
                        <a asp-controller="LibraryBranch" asp-action="Index" class="btn btn-outline-danger btn-sm w-100 mt-2">View All</a>
                    }
                    else
                    {
                        <p class="text-muted mt-3">No library branches available.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Categories -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h4 class="card-title text-info"><i class="bi bi-tags-fill me-2"></i>Categories</h4>
                    @if (Model.Categories != null && Model.Categories.Any())
                    {
                        <ul class="list-group list-group-flush mt-3">
                            @foreach (var category in Model.Categories.Take(5))
                            {
                                <li class="list-group-item px-0">@category.Name</li>
                            }
                        </ul>
                        <a asp-controller="Category" asp-action="Index" class="btn btn-outline-info btn-sm w-100 mt-2">View All</a>
                    }
                    else
                    {
                        <p class="text-muted mt-3">No categories available.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Borrow Records -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h4 class="card-title text-secondary"><i class="bi bi-journal-text me-2"></i>Borrow Records</h4>
                    @if (Model.BorrowRecords != null && Model.BorrowRecords.Any())
                    {
                        <table class="table table-sm mt-3">
                            <thead class="table-light">
                                <tr><th>Book</th><th>Customer</th></tr>
                            </thead>
                            <tbody>
                            @foreach (var record in Model.BorrowRecords.Take(5))
                            {
                                <tr>
                                    <td>@record.Book?.Title</td>
                                    <td>@record.Customer?.FullName</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                        <a asp-controller="BorrowRecord" asp-action="Index" class="btn btn-outline-secondary btn-sm w-100 mt-2">View All</a>
                    }
                    else
                    {
                        <p class="text-muted mt-3">No borrow records yet.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Librarians -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h4 class="card-title text-dark"><i class="bi bi-person-badge me-2"></i>Librarians</h4>
                    @if (Model.Librarians != null && Model.Librarians.Any())
                    {
                        <ul class="list-group list-group-flush mt-3">
                            @foreach (var librarian in Model.Librarians.Take(5))
                            {
                                <li class="list-group-item px-0">
                                    <strong>@librarian.FullName</strong><br />
                                    <small class="text-muted">@librarian.Email</small>
                                </li>
                            }
                        </ul>
                        <a asp-controller="Librarian" asp-action="Index" class="btn btn-outline-dark btn-sm w-100 mt-2">View All</a>
                    }
                    else
                    {
                        <p class="text-muted mt-3">No librarians listed yet.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Reviews -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h4 class="card-title text-purple"><i class="bi bi-star-half me-2"></i>Reviews</h4>
                    @if (Model.Reviews != null && Model.Reviews.Any())
                    {
                        <ul class="list-group list-group-flush mt-3">
                            @foreach (var review in Model.Reviews.Take(5))
                            {
                                <li class="list-group-item px-0">
                                    <strong>@review.Book?.Title</strong><br />
                                    <small>@review.Rating ⭐ - @review.Customer?.FullName</small>
                                </li>
                            }
                        </ul>
                        <a asp-controller="Review" asp-action="Index" class="btn btn-outline-primary btn-sm w-100 mt-2">View All</a>
                    }
                    else
                    {
                        <p class="text-muted mt-3">No reviews submitted yet.</p>
                    }
                </div>
            </div>
        </div>

    </div>
</div>
