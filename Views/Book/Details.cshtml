 <!-- Details.cshtml in LibraryManagement/Views/Book folder-->
@model LibraryManagement.ViewModels.BookViewModel
 
 <h1>@Model.Title</h1>
 <p>Author: @Model.AuthorName</p>
 <p>Branch: @Model.BranchName</p>
 <p>ISBN: @Model.ISBN</p>
<p>Published Year: @Model.PublishedYear</p>
<p>Status: @(Model.IsAvailableForBorrowing ? "Available" : "Not Available")</p>

 
