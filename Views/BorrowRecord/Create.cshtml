@model midterm_project.Models.BorrowRecord

<h2>Create Borrow Record</h2>

<form asp-action="Create" method="post">
    <div class="form-group mb-3">
        <label asp-for="BookId"></label>
        <select asp-for="BookId" asp-items="ViewBag.BookId" class="form-control"></select>
    </div>

    <div class="form-group mb-3">
        <label asp-for="CustomerId"></label>
        <select asp-for="CustomerId" asp-items="ViewBag.CustomerId" class="form-control"></select>
    </div>

    <div class="form-group mb-3">
        <label asp-for="BorrowDate"></label>
        <input asp-for="BorrowDate" type="date" class="form-control" />
    </div>

    <div class="form-group mb-3">
        <label asp-for="ReturnDate"></label>
        <input asp-for="ReturnDate" type="date" class="form-control" />
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsReturned" class="form-check-input" />
        <label asp-for="IsReturned" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
