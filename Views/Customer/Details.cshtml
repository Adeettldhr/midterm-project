@model midterm_project.Models.Customer

<h2>Customer Details</h2>

<table class="table table-bordered">
    <tr><th>Full Name</th><td>@Model.FullName</td></tr>
    <tr><th>Email</th><td>@Model.Email</td></tr>
    <tr><th>Phone</th><td>@Model.Phone</td></tr>
    <tr><th>Address</th><td>@Model.Address</td></tr>
    <tr><th>Registered On</th><td>@Model.RegisteredOn.ToString("yyyy-MM-dd")</td></tr>
</table>

<a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>
