@model midterm_project.Models.BorrowRecord

<h2 class="text-danger">Delete Borrow Record</h2>

<div class="alert alert-warning">Are you sure you want to delete this record?</div>

<div class="card p-3 mb-3">
    <p><strong>Book:</strong> @Model.Book?.Title</p>
    <p><strong>Customer:</strong> @Model.Customer?.FullName</p>
    <p><strong>Borrow Date:</strong> @Model.BorrowDate.ToString("yyyy-MM-dd")</p>
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="BorrowRecordId" />
    <button type="submit" class="btn btn-danger me-2">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
