@model midterm_project.Models.Librarian

<h2>Edit Librarian</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="LibrarianId" />

    <div class="form-group mb-3">
        <label asp-for="FullName"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" />
    </div>

    <div class="form-group mb-3">
        <label asp-for="Phone"></label>
        <input asp-for="Phone" class="form-control" />
    </div>

    <div class="form-group mb-3">
        <label asp-for="HiredDate"></label>
        <input asp-for="HiredDate" type="date" class="form-control" />
    </div>

    <div class="form-group mb-3">
        <label asp-for="LibraryBranchId">Branch</label>
        <select asp-for="LibraryBranchId" asp-items="ViewBag.LibraryBranchId" class="form-control"></select>
    </div>

    <button type="submit" class="btn btn-success">Update</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
