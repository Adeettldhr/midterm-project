@model midterm_project.Models.LibraryBranch

<h2>Library Branch Details</h2>

<table class="table table-bordered">
    <tr><th>Name</th><td>@Model.Name</td></tr>
    <tr><th>Address</th><td>@Model.Address</td></tr>
    <tr><th>Phone</th><td>@Model.Phone</td></tr>
    <tr><th>Open Date</th><td>@Model.OpenDate.ToString("yyyy-MM-dd")</td></tr>
</table>

<a asp-action="Edit" asp-route-id="@Model.LibraryBranchId" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>
