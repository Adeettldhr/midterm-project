@model IEnumerable<midterm_project.Models.Review>

<h2>📖 Book Reviews</h2>
<a asp-action="Create" class="btn btn-primary mb-3">Add Review</a>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Book</th>
            <th>Customer</th>
            <th>Rating</th>
            <th>Comment</th>
            <th>Date</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var review in Model)
    {
        <tr>
            <td>@review.Book?.Title</td>
            <td>@review.Customer?.FullName</td>
            <td>@review.Rating ⭐</td>
            <td>@review.Comment</td>
            <td>@review.ReviewDate.ToString("yyyy-MM-dd")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@review.ReviewId" class="btn btn-warning btn-sm">Edit</a>
                <a asp-action="Details" asp-route-id="@review.ReviewId" class="btn btn-info btn-sm">Details</a>
                <a asp-action="Delete" asp-route-id="@review.ReviewId" class="btn btn-danger btn-sm">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
