@model IEnumerable<midterm_project.Models.LibraryBranch>

<h2>Library Branches</h2>

<p>
    <a asp-action="Create" class="btn btn-success">Add New Branch</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Address</th>
            <th>Phone</th>
            <th>Open Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var branch in Model)
        {
            <tr>
                <td>@branch.Name</td>
                <td>@branch.Address</td>
                <td>@branch.Phone</td>
                <td>@branch.OpenDate.ToString("yyyy-MM-dd")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@branch.LibraryBranchId" class="btn btn-info btn-sm">Details</a>
                    <a asp-action="Edit" asp-route-id="@branch.LibraryBranchId" class="btn btn-primary btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@branch.LibraryBranchId" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
