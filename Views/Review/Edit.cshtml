@model midterm_project.Models.Review

<h2>Edit Review</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="ReviewId" />

    <div class="form-group mb-3">
        <label asp-for="BookId"></label>
        <select asp-for="BookId" asp-items="ViewBag.BookId" class="form-control"></select>
    </div>

    <div class="form-group mb-3">
        <label asp-for="CustomerId"></label>
        <select asp-for="CustomerId" asp-items="ViewBag.CustomerId" class="form-control"></select>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Rating"></label>
        <input asp-for="Rating" class="form-control" type="number" min="1" max="5" />
    </div>

    <div class="form-group mb-3">
        <label asp-for="Comment"></label>
        <textarea asp-for="Comment" class="form-control" rows="4"></textarea>
    </div>

    <div class="form-group mb-3">
        <label asp-for="ReviewDate"></label>
        <input asp-for="ReviewDate" type="date" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Update</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
