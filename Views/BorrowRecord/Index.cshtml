@model IEnumerable<midterm_project.Models.BorrowRecord>

<h2>Borrow Records</h2>
<a asp-action="Create" class="btn btn-primary mb-3">Add New Record</a>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Book</th>
            <th>Customer</th>
            <th>Borrow Date</th>
            <th>Return Date</th>
            <th>Returned?</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var record in Model)
    {
        <tr>
            <td>@record.Book?.Title</td>
            <td>@record.Customer?.FullName</td>
            <td>@record.BorrowDate.ToString("yyyy-MM-dd")</td>
            <td>@record.ReturnDate?.ToString("yyyy-MM-dd")</td>
            <td>@(record.IsReturned ? "Yes" : "No")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@record.BorrowRecordId" class="btn btn-warning btn-sm">Edit</a>
                <a asp-action="Details" asp-route-id="@record.BorrowRecordId" class="btn btn-info btn-sm">Details</a>
                <a asp-action="Delete" asp-route-id="@record.BorrowRecordId" class="btn btn-danger btn-sm">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
