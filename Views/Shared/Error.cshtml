@{
    ViewData["Title"] = "Error";
}

<div class="container d-flex flex-column align-items-center justify-content-center text-center" style="min-height: 80vh;">
    <div class="mb-4">
        <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 5rem;"></i>
    </div>

    <h1 class="display-3 fw-bold text-danger">
        @(ViewData["ErrorTitle"] ?? "Unexpected Error")
    </h1>

    <h2 class="display-6 text-secondary">
        @(
            ViewData["ErrorTitle"]?.ToString().Contains("Not Found") == true ? "404" :
            ViewData["ErrorTitle"]?.ToString().Contains("Denied") == true ? "403" : "500"
        )
    </h2>

    <p class="lead text-muted mt-3 mb-4">
        @ViewData["ErrorMessage"] ?? "Something went wrong while processing your request."
    </p>

    <a href="/" class="btn btn-primary btn-lg shadow-sm">
        <i class="bi bi-house-door-fill me-2"></i>Return to Home
    </a>
</div>

<!-- Optional styling to make the background softer -->
<style>
    body {
        background-color: #f8f9fa;
    }
</style>
